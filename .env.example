# Copy to .env in the project root. No external database is needed.
PORT=5038
HOST=127.0.0.1
DATA_DIR=.data
MAX_UPLOAD_MB=50
# Optional in development; these four local origins are allowed by default.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Leave blank when frontend and API share a domain or use the Vite proxy.
VITE_API_URL=
# Optional, used ONLY by npm run admin:setup. Omit to generate credentials.
# ADMIN_USERNAME=your-admin-name
# ADMIN_PASSWORD=your-unique-passphrase-at-least-14-characters
# For deployment: NODE_ENV=production and CLIENT_ORIGIN=https://your-domain.com
